    "faqs": [
      {
        "id": "faq-1",
        "question": "How does dual-channel verification work?",
        "answer": "Upon registration, a 6-digit one-time passcode (OTP) is dispatched via SMS to your registered mobile phone, and a confirmation code is dispatched to your email address. Both must be confirmed to complete verification."
      },
      {
        "id": "faq-2",
        "question": "What privileges does the main Admin account have?",
        "answer": "The primary admin account (ID: \"admin\") holds root administrative permissions. Only this account can promote users to administrators or demote them, suspend or delete any account, and manage system-wide settings."
      },
      {
        "id": "faq-3",
        "question": "Can I log in using just my phone number?",
        "answer": "Yes. In addition to password-based login, you can switch to \"Login via SMS OTP\" to receive a temporary one-time login passcode without entering your password."
      },
      {
        "id": "faq-4",
        "question": "How are failed logins and brute-force attempts handled?",
        "answer": "The platform tracks failed attempts per identifier. After reaching the configured limit (default: 5 attempts), the account is locked for 15 minutes, and all incidents are recorded in the security audit logs."
      }
    ],

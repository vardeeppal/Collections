# =========================================================================
# APPLICATION ENVIRONMENT CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# 1. ROOT ADMIN CREDENTIALS CONFIGURATION
# -------------------------------------------------------------------------
# Set the master administrator password for the special root account (ID: "admin").
# If unset or empty, the server automatically defaults to: Admin@2026!
# You can change this to any secure password (minimum 8 characters).
ADMIN_PASSWORD="Admin@2026!"

# -------------------------------------------------------------------------
# 2. SESSION & JWT SECURITY
# -------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (JWT) for authenticated sessions.
JWT_SECRET="replace-with-a-random-64-character-production-secret-key"

# -------------------------------------------------------------------------
# 3. REAL SMS SERVICE CONFIGURATION (TWILIO)
# -------------------------------------------------------------------------
# To send real SMS one-time passcodes (OTP) for phone verification and OTP login:
# 1. Create a Twilio account at https://www.twilio.com
# 2. Retrieve your Account SID and Auth Token from the Twilio Console.
# 3. Procure an SMS-capable Twilio phone number (in E.164 format, e.g. +14155552671).
# Note: If left unset, the built-in OTP Simulator will log codes to the server console
# and render on-screen verification helpers for instant testing.
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+18005550100"

# -------------------------------------------------------------------------
# 4. REAL EMAIL SERVICE CONFIGURATION (SENDGRID)
# -------------------------------------------------------------------------
# To dispatch real email confirmation links and password recovery codes:
# 1. Create an API key at https://app.sendgrid.com with 'Mail Send' permissions.
# 2. Verify a sender domain or single sender email address in SendGrid.
# Note: If left unset, the built-in Email Simulator will log codes to the server console
# and provide direct one-click confirmation links in development mode.
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
FROM_EMAIL="no-reply@yourdomain.com"

# -------------------------------------------------------------------------
# 5. HOSTING & DOMAIN SETTINGS
# -------------------------------------------------------------------------
# The public base URL where this application is hosted.
# Used for generating email confirmation links and OAuth redirects.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Automatically injected by Google AI Studio at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
